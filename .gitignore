node_modules/
dist/

# ---- Java / Maven ----
target/
*.class

# ---- 环境变量与密钥（.env.example 除外）----
.env
.env.*
!.env.example

# ---- IDE ----
.idea/
.vscode/
*.iml

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- 日志 ----
*.log

