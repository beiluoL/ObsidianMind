# ---- 依赖与构建产物 ----
node_modules/
dist/

# ---- Java / Maven ----
target/
*.class

# ---- 环境变量与密钥（.env.example 除外）----
.env
.env.*
!.env.example

# ---- IDE ----
.idea/
.vscode/
*.iml

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- 日志 ----
*.log

# ---- 本地运行数据（Milvus / Ollama / Vault 数据一律不入库）----
data/
volumes/
models/
milvus-data/
ollama-data/

# ---- 用户真实 Obsidian Vault（严禁提交）----
# 真实 Vault 只存在于用户本机，通过运行时显式连接，任何情况下不得提交到 Git
# 注意：必须锚定仓库根（/Vault/）。macOS 上 core.ignoreCase=true，
# 不锚定的 `Vault/` 会连 `src/components/vault/` 一起误伤，导致组件目录被静默忽略。
*.vault/
/Vault/
/vault-data/

# 本地运行产生的 PID / 日志
.run/

# AI 助手工作记忆（本地工作数据，不入库）
.workbuddy/
